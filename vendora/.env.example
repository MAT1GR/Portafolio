# ─── Base ───────────────────────────────────────────────
# Postgres (Neon, Supabase, RDS o local)
DATABASE_URL="postgresql://vendora:vendora@localhost:5432/vendora"
# URL pública del panel (sin barra final)
APP_URL="http://localhost:3000"
# Dominio raíz de las tiendas: con "vendora.shop" cada tienda vive en slug.vendora.shop
# (necesita DNS comodín *.vendora.shop apuntando al hosting). Vacío = solo /t/slug.
STORE_ROOT_DOMAIN=""
# Nombre de la marca que se muestra en toda la app
NEXT_PUBLIC_BRAND_NAME="Vendora"
# Secretos: generá cada uno con `openssl rand -base64 32`
AUTH_SECRET="cambiar-por-un-secreto-largo"
ENCRYPTION_KEY="cambiar-por-otro-secreto-largo"
CRON_SECRET="cambiar-por-un-secreto-para-cron"
# Email que queda como superadmin al registrarse (o al correr el seed)
ADMIN_EMAIL="admin@vendora.local"

# ─── Email (SMTP). Sin SMTP los correos quedan en /admin/correos ───
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vendora <no-reply@vendora.local>"

# ─── Archivos ───────────────────────────────────────────
# local = disco (Docker/VPS con volumen) · s3 = AWS S3, Cloudflare R2, MinIO, Supabase Storage (S3)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# URL pública del bucket para imágenes (ej. https://pub-xxx.r2.dev)
S3_PUBLIC_URL=""

# ─── IA (Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# low | medium | high
AI_EFFORT="medium"
# Opcional: solo para pruebas contra un servidor simulado
ANTHROPIC_BASE_URL=""

# ─── Notificaciones push de la app (npm run vapid) ─────
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@vendora.local"

# ─── Cobro de la plataforma (abonos y comisiones) ──────
PLATFORM_STRIPE_SECRET_KEY=""
PLATFORM_STRIPE_WEBHOOK_SECRET=""
PLATFORM_MP_ACCESS_TOKEN=""
PLATFORM_MP_WEBHOOK_SECRET=""
# Días para pagar una factura y días de gracia antes de suspender
BILLING_DUE_DAYS="7"
BILLING_GRACE_DAYS="7"

# ─── Varios ─────────────────────────────────────────────
# Habilita la pasarela "Modo prueba" en tiendas en modo prueba
ALLOW_TEST_PAYMENTS="true"
# Opcional: API para actualizar tipos de cambio (respuesta con { rates: { ARS: 1500, ... } })
FX_API_URL=""
